{
  "name": "okserver-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src vite.config.mts",
    "test": "npm run test:security && vitest run",
    "postinstall": "node scripts/picomatch-patch.mjs",
    "predev": "node scripts/picomatch-patch.mjs --check",
    "prebuild": "node scripts/picomatch-patch.mjs --check",
    "pretest": "node scripts/picomatch-patch.mjs --check",
    "test:security": "node --test scripts/picomatch-patch.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.13.0",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
